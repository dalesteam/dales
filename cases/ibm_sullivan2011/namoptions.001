&run
	iexpnr     =  001
	lwarmstart =  .false.
	startfile  =  'initd001h00mx000y000.001'
	runtime    =  600
	trestart   =  600
	irandom    =  43
	randthl    =  0.1
	randqt     =  0
	nsv        =  0
	ladaptive  = .true.
	nprocx     = 1
	nprocy     = 4
/

&domain
	itot       =  128 
	jtot       =  128
	kmax       =  128
	xsize      =  5120.
	ysize      =  5120.
	xlat       =  43.45
	xlon       =  0.
/

&physics
	ltimedep   =  .false.
	iradiation =  0
	lcoriol    =  .true.
/

&thermodynamics
	lmoist     = .false.
	lqlnr       = .false.
/

&namsurface
	z0         =  0.1
	thls       =  300.
	ps         =  100000.00
	isurf      =  4
	wtsurf     = 0.24
	wqsurf     = 0.0
/

&dynamics
	llsadv     =  .false.
	cu         =  0.
	cv         =  0.
	iadv_mom    =  2
	iadv_tke    =  2
	iadv_thl    =  2
	iadv_qt     =  2
	iadv_sv     =  2
/

&namsubgrid
	lmason = .false.
	lsmagorinsky = .false.
	ldelta = .false.
	sgs_surface_fix = .true.
/

&ibm
	lapply_ibm = .true.
	lwallheat = .true.
	thlibm = 300
	thlwall = 300
	thlroof = 300
	qtibm   = 0.000
	z0m_wall = 0.03
	z0h_wall = 0.03
/

&namchecksim
	tcheck = 10
	lchecktend = .true.
	lstop = .true.
/

&namnetcdfstats
    	lsync = .true.	
/

&namtimestat
	ltimestat   = .true.
	dtav        = 10
/

&namfielddump
	lfielddump  = .true.
	dtav        = 30
	ldiracc     = .true.
/

&nambuget 
	lbudget     = .true.
	dtav        = 6
	timeav      = 60
/

&NAMGENSTAT
	lstat       = .true.
	dtav        = 6
	timeav      = 60
/

&namcrosssection
	lcross  = .true.
	dtav    = 10
	crossheight = 2 6 12 16
	crossplane = 32 64
	lbinary = .false.
/
